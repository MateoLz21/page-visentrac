# URL canonica del sitio publicado, sin barra final.
NEXT_PUBLIC_SITE_URL=https://visentrac.com

# Clave publica de Web3Forms para el formulario de contacto.
# Se obtiene en https://web3forms.com indicando el correo destino.
# Es publica por diseno: restringir los dominios permitidos desde su panel.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Permitir que los buscadores indexen esta publicacion.
# Por defecto NO se indexa: una previsualizacion indexada compite en Google
# contra el sitio definitivo por las mismas busquedas.
# Poner true UNICAMENTE en el despliegue del dominio real.
NEXT_PUBLIC_INDEXABLE=false
