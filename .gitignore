# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# impeccable: generados y locales de sesion.
# El contrato de direccion en .impeccable/surfaces/ SI se versiona.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/questions/

# Skills instalados: son dependencias de herramienta, no codigo del proyecto.
# Se reinstalan con `npx impeccable install` y `npx skills add`.
# Si se versionaran, el binario de windows-x64 anadiria 17MB permanentes.
.claude/skills/
.claude/settings.local.json
.agents/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Credenciales del formulario. El .example si se versiona.
public/config.contacto.php
config.contacto.php

# Video institucional: 29 MB. Se sube por FTP junto al resto de out/.
# Fuera del repositorio porque git conserva cada version de los binarios para
# siempre, y una reedicion del video anadiria otros 29 MB permanentes.
public/visentrac.mp4
